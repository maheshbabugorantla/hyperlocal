# Pipeline (pipeline/pipeline.py) -- secret, never ship to the browser
SUPABASE_URL=
SUPABASE_SERVICE_KEY=          # or SUPABASE_SECRET_KEY (new-style sb_secret_ key)
CENSUS_API_KEY=
APIFY_TOKEN=
GEMINI_API_KEY=
# Optional, defaults to gemini-3.8-flash
GEMINI_MODEL=

# Frontend (Next.js, also set these in the Vercel project) -- anon key is read-only via RLS
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY= # anon key or sb_publishable_ key
# Only for `pipeline.py schema` (one-time table creation): DB password, or a full SUPABASE_DB_URL
SUPABASE_DB_PASSWORD=
